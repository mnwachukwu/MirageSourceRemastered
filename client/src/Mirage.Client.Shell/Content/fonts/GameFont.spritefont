<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Fixedsys Excelsior 3.01</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>false</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Latin-1 Supplement from the inverted marks up (not just the accents at
           &#192;): covers Spanish &#161; and &#191;, the guillemets &#171; &#187;,
           and the ordinals &#170; &#186;. -->
      <CharacterRegion>
        <Start>&#161;</Start>
        <End>&#255;</End>
      </CharacterRegion>
      <!-- French &#338; / &#339; ligature - Latin Extended-A, outside Latin-1. -->
      <CharacterRegion>
        <Start>&#338;</Start>
        <End>&#339;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
