<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\editor\src\Mirage.Editor\Mirage.Editor.csproj" />
  </ItemGroup>

  <!-- Hands the editor's source path to LocalizationConventionTests. Reflection can tell us a type's
       BASE CLASS but not whether it USES localized strings, and "uses localized strings" is the
       condition that actually needs a refresh hook - so that one check reads the sources. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EditorSourceRoot</_Parameter1>
      <!-- Baked in at build time because the test reads the editor's SOURCE, not its assembly, and a
           test binary has no idea where the repository is. This is the one path here that a
           ProjectReference rewrite does not fix for you — when the suites moved from
           editor/src/Mirage.Editor.Tests/ to tests/, the reference updated and this did not, and
           two tests failed with "Editor source root not found". They fail loudly rather than
           scanning zero files and passing, which is the only reason it was caught. -->
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\editor\src\Mirage.Editor</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
