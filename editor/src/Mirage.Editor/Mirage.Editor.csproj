<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Mirage.Editor</RootNamespace>
    <AssemblyName>$(GameNameSlug)-Editor</AssemblyName>
    <ApplicationIcon>$(EditorIcon)</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Avalonia"               Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop"       Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter"   Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
<PackageReference Include="CommunityToolkit.Mvvm"  Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\server\src\Mirage.Shared\Mirage.Shared.csproj" />
  </ItemGroup>

  <!-- Localization string files. -->
  <ItemGroup>
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tile/sprite/item bitmaps live alongside the client shell; reference them directly so there is
       only one copy in the repo. Link preserves each per-class subfolder under assets/graphics/ in the
       output, matching the assets root resolved by EditorPaths and the folder-based loaders. -->
  <ItemGroup>
    <Content Include="..\..\..\client\src\Mirage.Client.Shell\assets\graphics\tiles\**\*.*"
             CopyToOutputDirectory="PreserveNewest"
             Link="assets\graphics\tiles\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\..\client\src\Mirage.Client.Shell\assets\graphics\sprites\**\*.*"
             CopyToOutputDirectory="PreserveNewest"
             Link="assets\graphics\sprites\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\..\client\src\Mirage.Client.Shell\assets\graphics\items\**\*.*"
             CopyToOutputDirectory="PreserveNewest"
             Link="assets\graphics\items\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
