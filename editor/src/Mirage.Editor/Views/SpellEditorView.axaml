<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mirage.Editor.ViewModels" xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             x:Class="Mirage.Editor.Views.SpellEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: spell list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,4,4,2">
        <ComboBox x:Name="_typeFilterCombo"
                  Grid.Column="0"
                  ItemsSource="{Binding SpellTypeFilters}"
                  SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  FontSize="11"/>
        <Button Grid.Column="1" Content="×"
                Command="{Binding ClearTypeFilterCommand}"
                IsVisible="{Binding TypeFilter, Converter={x:Static ObjectConverters.IsNotNull}}"
                FontSize="11" Padding="6,0" Margin="2,0,0,0"/>
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,4,2">
        <ComboBox x:Name="_classReqFilterCombo"
                  Grid.Column="0"
                  ItemsSource="{Binding ClassReqFilterEntries}"
                  SelectedItem="{Binding ClassReqFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  FontSize="11">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="×"
                Command="{Binding ClearClassReqFilterCommand}"
                IsVisible="{Binding ClassReqFilter, Converter={x:Static ObjectConverters.IsNotNull}}"
                FontSize="11" Padding="6,0" Margin="2,0,0,0"/>
      </Grid>
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,0,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#888"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedSpell}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Ellipse Width="7" Height="7" Fill="#FF8C00"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="#333"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedSpell, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedSpell, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <Grid ColumnDefinitions="165,*">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedSpell.Name}" />
          </Grid>

          <Grid ColumnDefinitions="165,*">
            <TextBlock x:Name="_typeLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1"
                       ItemsSource="{Binding SpellTypes}"
                       SelectedItem="{Binding SelectedSpell.Type}"
                       HorizontalAlignment="Stretch"/>
          </Grid>

          <Grid ColumnDefinitions="165,*">
            <TextBlock x:Name="_classReqLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding ClassEntries}"
                             SelectedItem="{Binding SelectedClassReq, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"
                             x:Name="_classReqPicker"/>
          </Grid>

          <Grid ColumnDefinitions="165,*">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSpell.Data1Label}"
                       VerticalAlignment="Center"/>
            <!-- GiveItem: pick from item list -->
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding ItemEntries}"
                             SelectedItem="{Binding SelectedGiveItem, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"
                             x:Name="_giveItemPicker"
                             IsVisible="{Binding SelectedSpell.Data1IsGiveItem}"/>
            <!-- All other types: numeric -->
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.Data1}"
                           Minimum="-9999" Maximum="9999" FormatString="0"
                           IsVisible="{Binding SelectedSpell.Data1IsGiveItem,
                                       Converter={x:Static BoolConverters.Not}}"/>
          </Grid>

          <!-- Data2/Data3 are GiveItem-only (quantity + cost/level modifier); hidden for every other type. -->
          <Grid ColumnDefinitions="165,*" IsVisible="{Binding SelectedSpell.Data1IsGiveItem}">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSpell.Data2Label}"
                       VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.Data2}"
                           Minimum="-9999" Maximum="9999" FormatString="0"/>
          </Grid>

          <Grid ColumnDefinitions="165,*" IsVisible="{Binding SelectedSpell.Data1IsGiveItem}">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSpell.Data3Label}"
                       VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.Data3}"
                           Minimum="-9999" Maximum="9999" FormatString="0"/>
          </Grid>

          <Separator Margin="0,4,0,2" Background="#333"/>

          <!-- Calculated MP cost preview -->
          <Grid ColumnDefinitions="165,*">
            <TextBlock x:Name="_maxMpCostLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#888" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedSpell.MpCostDisplay}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </Grid>
          <!-- Reagent-per-cast preview (SubHp only) -->
          <Grid ColumnDefinitions="165,*" IsVisible="{Binding SelectedSpell.ShowReagentCost}">
            <TextBlock x:Name="_reagentCostLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#888" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedSpell.ReagentCost}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </Grid>
          <TextBlock x:Name="_mpCostNote"
                     FontSize="11" Foreground="#666" Margin="165,0,0,8"/>

          <!-- Formula notes panel -->
          <Border Background="#1A1A2A" BorderBrush="#334" BorderThickness="1"
                  CornerRadius="4" Padding="12,10" Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <TextBlock x:Name="_formulaNotesHeader" FontWeight="SemiBold" Foreground="#AAAACC" FontSize="12"/>

              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtData1Intro"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           x:Name="_fmtData1Bullet1"/>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           x:Name="_fmtData1Bullet2"/>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           x:Name="_fmtData1Bullet3"/>
              </StackPanel>

              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtClassIntNote"/>

              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtPlayerIntNote"/>

              <TextBlock x:Name="_fmtMagnitudeHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMagnitudeRaw"/>
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMagnitudeContribution"/>
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMagnitudeActualHit"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                         x:Name="_fmtMagnitudeMitNote"/>

              <TextBlock x:Name="_fmtMpCostHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMpCostFormula"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtMpCostNote"/>

              <TextBlock TextWrapping="Wrap" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"
                         x:Name="_fmtGiveItemHeader"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           x:Name="_fmtGiveItemBullet1"/>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           x:Name="_fmtGiveItemBullet2"/>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11"
                           x:Name="_fmtGiveItemBullet3"/>
              </StackPanel>

              <TextBlock x:Name="_fmtMaxMpHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMaxMpFormula"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtMaxMpNote"/>

              <TextBlock x:Name="_fmtRangeHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtRangeFormula"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtRangeNote"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="#88FF88"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: always-visible Save / Discard strip ── -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="8,6"
            BorderBrush="#444" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button x:Name="_discardBtn"
                Command="{Binding DiscardCommand}"
                IsEnabled="{Binding IsSelectedDirty}"
                Background="#6B1500" Foreground="White"/>
        <Button x:Name="_discardAllBtn"
                Command="{Binding DiscardAllCommand}"
                IsEnabled="{Binding HasAnyDirty}"
                Background="#6B3300" Foreground="White"/>
        <Button x:Name="_saveBtn"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsSelectedDirty}"
                Background="#1A5A1A" Foreground="White"/>
        <Button x:Name="_saveAllBtn"
                Command="{Binding SaveAllCommand}"
                IsEnabled="{Binding HasAnyDirty}"
                Background="#1A3A6A" Foreground="White"/>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
