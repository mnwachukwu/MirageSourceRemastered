<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mirage.Editor.ViewModels" xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             x:Class="Mirage.Editor.Views.ItemEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: item list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,4,4,2">
        <ComboBox x:Name="_typeFilterCombo"
                  Grid.Column="0"
                  ItemsSource="{Binding ItemTypeFilters}"
                  SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  FontSize="11"/>
        <Button Grid.Column="1" Content="×"
                Command="{Binding ClearTypeFilterCommand}"
                IsVisible="{Binding TypeFilter, Converter={x:Static ObjectConverters.IsNotNull}}"
                FontSize="11" Padding="6,0" Margin="2,0,0,0"/>
      </Grid>
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,0,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#888"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedItem}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Ellipse Width="7" Height="7" Fill="#FF8C00"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="#333"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <Grid ColumnDefinitions="120,*">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedItem.Name}" />
          </Grid>

          <Grid ColumnDefinitions="120,*">
            <TextBlock x:Name="_picLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ItemPicEntries}"
                      SelectedItem="{Binding SelectedItem.PicAsInt, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:AtlasFramePreview
                        FrameIndex="{Binding}"
                        Atlas="{Binding $parent[ComboBox].DataContext.ItemBitmap}"
                        Mode="ItemStrip"
                        IsHighlighted="{Binding $parent[ComboBoxItem].IsPointerOver}"/>
                    <TextBlock Text="{Binding, StringFormat='#{0}'}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="120,*">
            <TextBlock x:Name="_typeLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1"
                       ItemsSource="{Binding ItemTypes}"
                       SelectedItem="{Binding SelectedItem.Type}"
                       HorizontalAlignment="Stretch" />
          </Grid>

          <!-- Data1: shown unless type is None/Currency -->
          <Grid ColumnDefinitions="120,*"
                IsVisible="{Binding SelectedItem.Data1Visible}">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedItem.Data1Label}"
                       VerticalAlignment="Center"/>
            <!-- Spell scroll: pick from spell list -->
            <controls:DropdownAutoCompleteBox x:Name="_spellPicker" Grid.Column="1"
                             ItemsSource="{Binding SpellEntries}"
                             SelectedItem="{Binding SelectedSpellItem, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"
                             IsVisible="{Binding SelectedItem.Data1IsSpell}"/>
            <!-- All other types: numeric field -->
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedItem.Data1}"
                           Minimum="-9999" Maximum="9999" FormatString="0"
                           IsVisible="{Binding SelectedItem.Data1IsSpell,
                                       Converter={x:Static BoolConverters.Not}}"/>
          </Grid>

          <!-- Data2: shown for equipment only -->
          <Grid ColumnDefinitions="120,*"
                IsVisible="{Binding SelectedItem.Data2Visible}">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedItem.Data2Label}"
                       VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedItem.Data2}"
                           Minimum="-9999" Maximum="9999" FormatString="0"/>
          </Grid>

          <!-- Data3 (Class Req): shown for equipment only — picks a class from the live list. -->
          <Grid ColumnDefinitions="120,*"
                IsVisible="{Binding SelectedItem.Data3Visible}">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedItem.Data3Label}"
                       VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox x:Name="_classPicker" Grid.Column="1"
                             ItemsSource="{Binding ClassEntries}"
                             SelectedItem="{Binding SelectedClassReq, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"/>
          </Grid>

          <!-- Item restriction flags (S10 authoring surface; enforcement of the new flags lands in S10) -->
          <TextBlock x:Name="_restrictionsLabel" FontWeight="SemiBold" Margin="0,6,0,0"/>
          <StackPanel Margin="8,0,0,0" Spacing="2">
            <CheckBox x:Name="_nonTradeableCheck"  IsChecked="{Binding SelectedItem.NonTradeable}"/>
            <CheckBox x:Name="_nonListableCheck"   IsChecked="{Binding SelectedItem.NonListable}"/>
            <CheckBox x:Name="_nonMailableCheck"   IsChecked="{Binding SelectedItem.NonMailable}"/>
            <CheckBox x:Name="_destroyOnDropCheck" IsChecked="{Binding SelectedItem.DestroyOnDrop}"/>
          </StackPanel>

          <Separator Margin="0,4,0,2" Background="#333"/>

          <!-- Item type notes panel -->
          <Border Background="#1A1A2A" BorderBrush="#334" BorderThickness="1"
                  CornerRadius="4" Padding="12,10" Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <TextBlock x:Name="_fieldNotesHeader" FontWeight="SemiBold" Foreground="#AAAACC" FontSize="12"/>

              <!-- Equipment -->
              <TextBlock x:Name="_notesEquipmentHeader"
                         FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock x:Name="_notesEquipmentDurability" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                <TextBlock x:Name="_notesEquipmentDamageDef"  TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                <StackPanel Margin="12,0,0,0" Spacing="2">
                  <TextBlock x:Name="_notesEquipmentWeapon" TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
                  <TextBlock x:Name="_notesEquipmentArmor"  TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
                  <TextBlock x:Name="_notesEquipmentHelmet" TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
                  <TextBlock x:Name="_notesEquipmentShield" TextWrapping="Wrap" Foreground="#777" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
                </StackPanel>
                <TextBlock x:Name="_notesEquipmentClassReq"   TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                <TextBlock x:Name="_notesEquipmentShieldSide" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
              </StackPanel>

              <!-- Potions -->
              <TextBlock x:Name="_notesPotionsHeader"
                         FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock x:Name="_notesPotionsData1" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
              </StackPanel>

              <!-- Spell scrolls -->
              <TextBlock x:Name="_notesSpellScrollHeader"
                         FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock x:Name="_notesSpellScrollData1" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
              </StackPanel>

              <!-- Key -->
              <TextBlock x:Name="_notesKeyHeader"
                         FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock x:Name="_notesKeyData1" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
              </StackPanel>

              <!-- Currency -->
              <TextBlock x:Name="_notesCurrencyHeader"
                         FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock x:Name="_notesCurrencyDesc" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
              </StackPanel>

            </StackPanel>
          </Border>

          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="#88FF88"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: always-visible Save / Discard strip ── -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="8,6"
            BorderBrush="#444" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button x:Name="_discardBtn"
                Command="{Binding DiscardCommand}"
                IsEnabled="{Binding IsSelectedDirty}"
                Background="#6B1500" Foreground="White"/>
        <Button x:Name="_discardAllBtn"
                Command="{Binding DiscardAllCommand}"
                IsEnabled="{Binding HasAnyDirty}"
                Background="#6B3300" Foreground="White"/>
        <Button x:Name="_saveBtn"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsSelectedDirty}"
                Background="#1A5A1A" Foreground="White"/>
        <Button x:Name="_saveAllBtn"
                Command="{Binding SaveAllCommand}"
                IsEnabled="{Binding HasAnyDirty}"
                Background="#1A3A6A" Foreground="White"/>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
