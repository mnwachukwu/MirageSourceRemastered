<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mirage.Editor.ViewModels" xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             x:Class="Mirage.Editor.Views.ConversationEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: conversation list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,4,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#8B84AE"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedConversation}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MirageWarnBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#6B6491" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <Grid ColumnDefinitions="110,*">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedConversation.Name}" />
          </Grid>

          <Grid ColumnDefinitions="110,*">
            <TextBlock x:Name="_speakerLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding SelectedConversation.NpcEntries}"
                             SelectedItem="{Binding SelectedConversation.SelectedSpeaker, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"/>
          </Grid>

          <Grid ColumnDefinitions="110,*">
            <TextBlock x:Name="_rootLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding SelectedConversation.RootNodeEntries}"
                             SelectedItem="{Binding SelectedConversation.SelectedRootNode, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"
                             PlaceholderText="{Binding SelectedConversation.RootNodePlaceholder}"/>
          </Grid>

          <!-- ── Dialogue nodes (each node owns its own choices table) ── -->
          <TextBlock x:Name="_nodesHeader" Margin="0,8,0,2" FontWeight="SemiBold"/>
          <TextBlock x:Name="_noNodesHint" Margin="0,2" Foreground="#8B84AE" FontStyle="Italic"
                     IsVisible="{Binding SelectedConversation.HasNoNodes}"/>
          <ItemsControl ItemsSource="{Binding SelectedConversation.Nodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="8">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,34">
                      <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="-" FontWeight="Bold"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectedConversation.RemoveNodeCommand}"
                              CommandParameter="{Binding}"
                              Classes="glyph" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox Text="{Binding Speaker}" PlaceholderText="{Binding SpeakerPlaceholder}"/>
                    <TextBox Text="{Binding Text}" PlaceholderText="{Binding TextPlaceholder}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalContentAlignment="Top"/>

                    <TextBlock Text="{Binding ChoicesLabel}" Foreground="{DynamicResource MirageMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding NoChoicesHint}" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"
                               IsVisible="{Binding HasNoChoices}"/>
                    <ItemsControl ItemsSource="{Binding Choices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="2*,2*,*,34" HorizontalAlignment="Stretch" Margin="0,0,0,2">
                            <TextBox Grid.Column="0" Text="{Binding Label}" PlaceholderText="{Binding LabelPlaceholder}"/>
                            <controls:DropdownAutoCompleteBox Grid.Column="1" Margin="4,0,0,0"
                                             ItemsSource="{Binding NextNodeEntries}"
                                             SelectedItem="{Binding SelectedNextNode, Mode=TwoWay}"
                                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                             FilterMode="Custom" MinimumPrefixLength="0"
                                             PlaceholderText="{Binding NextPlaceholder}"/>
                            <ComboBox Grid.Column="2" Margin="4,0,0,0" ItemsSource="{Binding Actions}"
                                      SelectedItem="{Binding Action}" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="3" Content="-" FontWeight="Bold"
                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveChoiceCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="glyph" Margin="4,0,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding AddChoiceLabel}"
                            Command="{Binding AddChoiceCommand}"
                            HorizontalAlignment="Left" Padding="10,3"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="_addNodeBtn"
                  Command="{Binding SelectedConversation.AddNodeCommand}"
                  HorizontalAlignment="Left" Padding="10,3"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: status line, and the always-visible Save / Discard strip ── -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="8,6"
            BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="_discardBtn"
                  Command="{Binding DiscardCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="danger"/>
          <Button x:Name="_discardAllBtn"
                  Command="{Binding DiscardAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="danger"/>
          <Button x:Name="_saveBtn"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="primary"/>
          <Button x:Name="_saveAllBtn"
                  Command="{Binding SaveAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="primary"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MirageOkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
