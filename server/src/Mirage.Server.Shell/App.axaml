<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mirage.Server.Shell.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <!-- The quieter line under a label. -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#9AA3B2"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Fixed pitch so timestamps and levels line up into columns. -->
    <Style Selector="TextBox.log">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
    </Style>
    <!-- All four states pinned to the same chrome: this is a reading surface that happens to be a
         TextBox, and clicking in to copy a line should not repaint the panel. -->
    <Style Selector="TextBox.log /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#11151C"/>
      <Setter Property="BorderBrush" Value="#2A3240"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#11151C"/>
      <Setter Property="BorderBrush" Value="#2A3240"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#11151C"/>
      <Setter Property="BorderBrush" Value="#2A3240"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.log:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#11151C"/>
      <Setter Property="BorderBrush" Value="#2A3240"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Application.Styles>

</Application>
