{
  "name": "Little Bram (Local)",
  "speakerNpc": 152,
  "rootNodeId": 1,
  "nodes": [
    {
      "id": 1,
      "speaker": "",
      "text": "Want to hear a joke? Maud says I\u0027m not to tell it to customers but you\u0027re not a customer, you\u0027re an adventurer.",
      "choices": [
        {
          "label": "Go on then.",
          "nextNodeId": 2,
          "action": "None"
        },
        {
          "label": "Not right now.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    },
    {
      "id": 2,
      "speaker": "",
      "text": "How many bandits does it take to hold a causeway?\n\n...Fewer, once you\u0027ve been through. That\u0027s the joke. Maud says it\u0027s not a joke, it\u0027s just a fact said in a joke voice.",
      "choices": [
        {
          "label": "It\u0027s not bad.",
          "nextNodeId": 3,
          "action": "None"
        },
        {
          "label": "That\u0027s terrible.",
          "nextNodeId": 4,
          "action": "None"
        }
      ]
    },
    {
      "id": 3,
      "speaker": "",
      "text": "Ha! I\u0027m telling her you said that.",
      "choices": [
        {
          "label": "Do that.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    },
    {
      "id": 4,
      "speaker": "",
      "text": "That\u0027s what she said.\n\nI\u0027ll get a better one. I\u0027ve got all week - I\u0027m not allowed past the second stilt.",
      "choices": [
        {
          "label": "Keep working on it.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    }
  ]
}