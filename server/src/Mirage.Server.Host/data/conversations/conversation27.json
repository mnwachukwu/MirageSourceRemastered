  "rootNodeId": 1,
  "nodes": [
    {
      "id": 1,
      "speaker": "",
      "text": "You\u0027re the one Sera\u0027s been sending out, then.\n\nI dig the drainage. Nobody writes that down either.",
      "choices": [
        {
          "label": "What\u0027s the mood here?",
          "nextNodeId": 2,
          "action": "None"
        },
        {
          "label": "Heard anything worth hearing?",
          "nextNodeId": 3,
          "action": "None"
        },
        {
          "label": "Just passing.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    },
    {
      "id": 2,
      "speaker": "",
      "text": "Tired. Not frightened \u2014 we did frightened about four years ago and it turns out you cannot keep it up.\n\nNow it is just Tuesday, and on Tuesday the ditch needs digging.",
      "choices": [
        {
          "label": "Heard anything?",
          "nextNodeId": 3,
          "action": "None"
        },
        {
          "label": "Fair enough.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    },
    {
      "id": 3,
      "speaker": "",
      "text": "Osric swears the water went out further than usual last month. Says he could see the old road.\n\nI told him the old road is a story his father told him. He told me his father dug this ditch. So now we are not speaking.",
      "choices": [
        {
          "label": "What\u0027s the mood here?",
          "nextNodeId": 2,
          "action": "None"
        },
        {
          "label": "I\u0027ll leave you to it.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    }
  ]
}