<Project Sdk="Microsoft.Build.NoTargets/3.7.0">

  <!-- Runs the server suite on its own — the test-side mirror of Mirage.Server.Publish.csproj, and
       one of four such drivers (client, server, editor, plus the aggregate Mirage.Test.csproj at the
       repository root).

       Why an area driver exists at all when `dotnet test <project>` is one line: this is the name a
       reader already knows. Publishing the server is Mirage.Server.Publish.csproj, so testing it is
       Mirage.Server.Test.csproj, and neither requires remembering where the suite happens to live.
       The suites moved to /tests/ once already; that move edited these four drivers and nothing that
       calls them.

         dotnet msbuild server/Mirage.Server.Test.csproj /t:TestAll

       Covers Mirage.Shared as well as the server: the shared protocol types, records and formulas
       have no suite of their own and are exercised from here. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <_ServerTests>$(MSBuildThisFileDirectory)../tests/Mirage.Server.Tests/Mirage.Server.Tests.csproj</_ServerTests>
  </PropertyGroup>

  <!-- Built through the MSBuild task rather than left to `dotnet test`, for the reason spelled out at
       length in Mirage.Test.csproj: a nested `dotnet test` is a separate MSBuild PROCESS writing the
       same bin/obj as an outer solution build, and cross-process builds share no result cache.
       Routing the build through the task puts it in this build's own scheduler instead. -->
  <Target Name="BuildSuite">
    <MSBuild Projects="$(_ServerTests)" Targets="Restore" />
    <MSBuild Projects="$(_ServerTests)" Targets="Build" />
  </Target>

  <Target Name="TestAll" DependsOnTargets="BuildSuite">
    <Message Text="── Server ──" Importance="High" />
    <Exec Command="dotnet test &quot;$(_ServerTests)&quot; --no-build --configuration $(Configuration) --nologo" />
  </Target>

  <!-- No ContinueOnError above, unlike the aggregate: with one suite there is nothing to hide behind
       it, so a plain failure is the clearest report. -->

  <!-- Build does NOT chain to TestAll, and that is the whole point of this target existing.
       This project is a member of Mirage.slnx, where Mirage.Test.csproj already runs every suite on
       a solution build. If this one ran its suite too, `dotnet build Mirage.slnx` would test the
       server twice — the same double-work that once turned a 9-second solution build into a
       127-second one when the Publish projects defaulted to publishing. Requesting TestAll
       explicitly is what makes an area driver free to sit in the solution. -->
  <Target Name="Build">
    <Message Importance="High"
             Text="Mirage.Server.Test: nothing run. Use /t:TestAll to test the server on its own; a solution build already tests everything via Mirage.Test.csproj." />
  </Target>

</Project>
